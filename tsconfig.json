{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["core/**/*.ts", "tests/**/*.ts", "examples/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist", "server", "examples/**/reference-*"]
}
